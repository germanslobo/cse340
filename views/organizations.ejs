<%- include('partials/header') %>
<main class="container">
    <h1><%= title %></h1>
    <p>Explore the inspiring organizations making a difference in our communities:</p>

    <div class="actions" style="margin-top: 1rem;">
        <a href="/new-organization">Add New Organization</a>
    </div>

    <div class="organization-list" style="display: flex; flex-direction: column; gap: 2rem; margin-top: 1.5rem;">
        
        <% if (organizations && organizations.length > 0) { %>
            <% organizations.forEach((org) => { %>
                <!-- Cada tarjeta es un enlace funcional hacia la página de detalles de la organización -->
                <a href="/organization/<%= org.organization_id %>" style="text-decoration: none; color: inherit;">
                    <div class="org-card" style="display: flex; gap: 1.5rem; align-items: center; background: #f9f9f9; padding: 1rem; border-radius: 8px; transition: transform 0.2s ease;">
                        <!-- Imagen dinámica basada en el ID de la organización -->
                        <img src="/images/org<%= org.organization_id %>.png" alt="<%= org.name %>" style="width: 200px; height: 130px; object-fit: cover; border-radius: 6px;">
                        <div>
                            <h3 style="margin-top: 0; color: #004080;"><%= org.name %></h3>
                            <p style="margin-bottom: 0; color: #555555;"><%= org.description %></p>
                        </div>
                    </div>
                </a>
            <% }) %>
        <% } else { %>
            <p>No organizations found at this time.</p>
        <% } %>

    </div>
</main>
<%- include('partials/footer') %>