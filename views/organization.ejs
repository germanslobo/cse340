<%- include('partials/header') %>

<main class="container">
    <h1><%= organization.name %></h1>
    <p><strong>Descripción:</strong> <%= organization.description %></p>
    <% if (organization.contact_email) { %>
        <p><strong>Contacto:</strong> <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a></p>
    <% } %>

    <h2>Proyectos de esta Organización</h2>
    <div class="projects-section">
        <% if (projects && projects.length > 0) { %>
            <ul class="projects-list">
                <% projects.forEach(project => { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <strong><%= project.title %></strong>
                        </a>
                        <span> — <%= project.location %> (<%= project.date %>)</span>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No projects found for this organization.</p>
        <% } %>
    </div>

    <br>
    <a href="/edit-organization/<%= organization.organization_id %>">Edit Organization</a>
    <br><br>
    <a href="/organizations">← Back to Organizations</a>
</main>

<%- include('partials/footer') %>