<%- include('partials/header') %>

<main class="container">
    <h1>Create New Service Project</h1>

    <% if (error) { %>
        <p class="error-message" role="alert"><%= error %></p>
    <% } %>

    <form action="/new-project" method="POST" class="form-container">
        <div class="form-group">
            <label for="title">Project Title:</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= project.title || '' %>"
                maxlength="150"
                required
            >
        </div>

        <div class="form-group">
            <label for="description">Description:</label>
            <textarea
                id="description"
                name="description"
                rows="4"
                maxlength="1500"
                required
            ><%= project.description || '' %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location:</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= project.location || '' %>"
                maxlength="150"
                required
            >
        </div>

        <div class="form-group">
            <label for="date">Date:</label>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= project.date || '' %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="organization_id">Sponsoring Organization:</label>
            <select id="organization_id" name="organization_id" required>
                <option value="">-- Select an Organization --</option>
                <% if (organizations && organizations.length > 0) { %>
                    <% organizations.forEach((org) => { %>
                        <option
                            value="<%= org.organization_id %>"
                            <%= Number(project.organization_id) === Number(org.organization_id) ? 'selected' : '' %>
                        >
                            <%= org.name %>
                        </option>
                    <% }) %>
                <% } %>
            </select>
        </div>

        <div class="form-actions">
            <button type="submit">Create Service Project</button>
            <a href="/projects">Cancel</a>
        </div>
    </form>
</main>

<%- include('partials/footer') %>