<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css"> <!-- O tu ruta de estilos -->
</head>
<body>
    <!-- Tu barra de navegación o header existente -->
    
    <main class="container">
        <h1><%= title %></h1>
        <p>Explore our active service projects in the community.</p>

        <!-- Sección añadida para mostrar los proyectos dinámicos de la base de datos -->
        <div class="projects-section">
            <% if (projects && projects.length > 0) { %>
                <ul class="projects-list">
                    <% projects.forEach(project => { %>
                        <li>
                            <strong><%= project.date %></strong>: 
                            <%= project.title %> 
                            (<em><%= project.organization_name %></em>)
                            <p><%= project.description %></p>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p>No service projects found at this time.</p>
            <% } %>
        </div>
    </main>

    <!-- Tu footer existente -->
</body>
</html>