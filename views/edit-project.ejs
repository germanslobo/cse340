<%- include('partials/header') %>

<main class="container">
    <h1>Edit Service Project</h1>

    <% if (error) { %>
        <p class="error-message" role="alert"><%= error %></p>
    <% } %>

    <form action="/edit-project/<%= project.project_id %>" method="POST" class="form-container">
        <div class="form-group">
            <label for="title">Title:</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= project.title %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="description">Description:</label>
            <textarea
                id="description"
                name="description"
                rows="4"
                required
            ><%= project.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location:</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= project.location %>"
                required
            >
        </div>

        <%
            let formattedDate = '';
            if (project.date) {
                const d = new Date(project.date);
                if (!Number.isNaN(d.getTime())) {
                    formattedDate = d.toISOString().split('T')[0];
                } else if (typeof project.date === 'string') {
                    formattedDate = project.date.slice(0, 10);
                }
            }
        %>
        <div class="form-group">
            <label for="date">Date:</label>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= formattedDate %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="organization_id">Organization:</label>
            <select id="organization_id" name="organization_id" required>
                <% if (organizations && organizations.length > 0) { %>
                    <% organizations.forEach(org => { %>
                        <option
                            value="<%= org.organization_id %>"
                            <%= Number(org.organization_id) === Number(project.organization_id) ? 'selected' : '' %>
                        >
                            <%= org.name %>
                        </option>
                    <% }) %>
                <% } %>
            </select>
        </div>

        <div class="form-actions">
            <button type="submit">Save Changes</button>
            <a href="/project/<%= project.project_id %>">Cancel</a>
        </div>
    </form>
</main>

<%- include('partials/footer') %>