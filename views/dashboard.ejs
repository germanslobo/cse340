<%- include('partials/header') %>

<section class="dashboard-section">
    <h1>Dashboard</h1>

    <% if (currentUser) { %>
        <div class="user-summary">
            <p><strong>Name:</strong> <%= currentUser.name %></p>
            <p><strong>Email:</strong> <%= currentUser.email %></p>
            <p><strong>Role:</strong> <%= currentUser.role %></p>
        </div>

        <div class="dashboard-actions">
            <a href="/organizations" class="btn">View Organizations</a>
            <a href="/projects" class="btn">View Projects</a>
            <a href="/categories" class="btn">View Categories</a>

            <% if (currentUser.role === 'admin') { %>
                <a href="/users" class="btn btn-admin">Manage Users</a>
            <% } %>
        </div>

        <section class="volunteered-projects">
            <h2>My Volunteered Projects</h2>
            <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
                <ul>
                    <% volunteeredProjects.forEach(proj => { %>
                        <li>
                            <a href="/project/<%= proj.project_id %>"><strong><%= proj.title %></strong></a>
                            <span>— <%= proj.organization_name %> (<%= proj.date %>)</span>
                            <a href="/project/<%= proj.project_id %>/unvolunteer?redirect=dashboard" class="btn btn-small">Remove Volunteering</a>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p>You have not volunteered for any projects yet.</p>
            <% } %>
        </section>
    <% } %>
</section>

<%- include('partials/footer') %>